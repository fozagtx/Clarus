# Optional. Public Solana RPC works without this.
# Prefer Helius / a dedicated RPC for sub-2.5s pipeline latency.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
HELIUS_API_KEY=

# Optional Telegram dispatch. The dashboard works without these.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Suggested execution size used for slippage calibration (USD).
DEFAULT_TRADE_USD=50
MAX_SLIPPAGE_PCT=2
VOLUME_TO_MC_RATIO=0.8
MAX_HOLDER_PCT=3.5
MIN_LP_LOCKED_PCT=95
