# Public Binance ticker (used for HUD health). No API key.
# GoPlus + Dexscreener + GeckoTerminal need none.

BSC_RPC_URL=https://bsc-dataseed.binance.org

# Suggested execution size used for slippage calibration (USD).
DEFAULT_TRADE_USD=50
MAX_SLIPPAGE_PCT=2
VOLUME_TO_MC_RATIO=0.8
MAX_HOLDER_PCT=3.5
MIN_LP_LOCKED_PCT=95
