{
  "name": "Clarus",
  "version": "0.2.0",
  "contest": "Binance Agent OS Mini Hackathon — Track A",
  "chain": "BNB Smart Chain",
  "chainId": 56,
  "permissions": {
    "privateKeys": false,
    "seedPhrases": false,
    "autonomousBroadcast": false
  },
  "mcp": {
    "transport": "http",
    "path": "/api/mcp",
    "binanceAgentMcp": "https://agent.binance.com/mcp/agentic"
  },
  "ifThenRules": [
    {
      "if": "new BSC pair or social CA spike",
      "then": "lock CA and start firewall within 500ms"
    },
    {
      "if": "token is mintable OR hidden owner OR can reclaim ownership",
      "then": "REJECT and log"
    },
    {
      "if": "pausable, blacklist, or honeypot",
      "then": "REJECT and log"
    },
    {
      "if": "LP locked/burned < 95%",
      "then": "REJECT and log"
    },
    {
      "if": "largest non-AMM holder > 3.5%",
      "then": "REJECT and log"
    },
    {
      "if": ">3 wallets share a funding origin in 60s OR GoPlus same-creator honeypot",
      "then": "REJECT as bundled"
    },
    {
      "if": "volume < 0.80 * market cap",
      "then": "REJECT as distorted tape"
    },
    {
      "if": "$50 clip slippage > 2%",
      "then": "shrink suggested size until ≤2%"
    },
    {
      "if": "all checks pass",
      "then": "emit PancakeSwap + Binance Web3 deep link. User signs in wallet."
    }
  ],
  "tools": [
    {
      "name": "ingest_recent",
      "provider": "GeckoTerminal BSC pools + Dexscreener bsc",
      "sideEffects": "read-only"
    },
    {
      "name": "evaluate_token",
      "provider": "GoPlus token_security/56 + local firewall",
      "sideEffects": "read-only"
    },
    {
      "name": "build_swap_payload",
      "provider": "PancakeSwap deep link + Binance Web3 router URL",
      "sideEffects": "none — no signing, no broadcast"
    }
  ]
}
